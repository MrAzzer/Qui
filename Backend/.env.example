# Skopiuj do Backend/.env i uzupełnij. Nie commituj .env!

# AI (domyślnie GroqCloud, API zgodne z OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_RESPONSE_FORMAT=json_schema

# Przełączenie na NVIDIA API:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_RESPONSE_FORMAT=json_object

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# Baza: puste = plik qui.db obok (SQLite). Produkcja: PostgreSQL, np. z Neon:
# DATABASE_URL=postgresql://user:haslo@ep-xxx.eu-central-1.aws.neon.tech/qui?sslmode=require
DATABASE_URL=sqlite:///./qui.db

# Klucz do podpisywania tokenów logowania (min. 32 znaki). Wygeneruj:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
