# Skopiuj do Backend/.env i uzupełnij. Nie commituj .env!

# AI (domyślnie GroqCloud, API zgodne z OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_RESPONSE_FORMAT=json_schema

# Przełączenie na NVIDIA API:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_RESPONSE_FORMAT=json_object

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# Baza: lokalnie plik SQLite. Produkcja: Neon PostgreSQL — adres BEZ "-pooler" (backend ma własną pulę połączeń):
# DATABASE_URL=postgresql://user:haslo@ep-xxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///./qui.db

# Pliki materiałów (Neon Storage / dowolny S3). Puste S3_BUCKET = zapisujemy tylko tekst, bez pliku.
S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Klucz do podpisywania tokenów logowania (min. 32 znaki). Wygeneruj:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
